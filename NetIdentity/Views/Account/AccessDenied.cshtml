@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = ViewData != null ? ViewData["Title"]?.ToString() ?? "Acceso Denegado" : "Acceso Denegado";
    var originalUrl = Context.Request.Query["ReturnUrl"].ToString();
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <div class="card border-danger">
            <div class="card-body">
                <i class="bi bi-x-circle text-danger" style="font-size: 4rem;"></i>
                <h1 class="display-4 text-danger mt-3">Acceso Denegado</h1>
                <p class="lead">No tienes permisos para acceder a esta sección.</p>
                <hr>
                <p class="mb-4">
                    Razón:
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        var reasons = new List<string>();
                    if (!(await AuthorizationService.AuthorizeAsync(User, null, "SoloMasculino")).Succeeded)
                    {
                        reasons.Add("Esta sección está restringida a usuarios con género masculino.");
                    }
                    if (originalUrl.Contains("/Juegos/JuegoEducativo") && !(await AuthorizationService.AuthorizeAsync(User, null, "AdminOUsuario")).Succeeded)
                    {
                        reasons.Add("Esta sección está restringida a usuarios con rol Admin o Usuario.");
                    }
                    if (originalUrl.Contains("/Juegos/Aventuras") && !(await AuthorizationService.AuthorizeAsync(User, null, "SoloAdmin")).Succeeded)
                    {
                        reasons.Add("Esta sección está restringida a administradores.");
                    }
                    if (originalUrl.Contains("/Actividades/Deportes") && !(await AuthorizationService.AuthorizeAsync(User, null, "menoresEdad")).Succeeded)
                    {
                        reasons.Add("Esta sección está restringida a menores de 18 años.");
                    }
                    if (reasons.Any())
                    {
                        <ul>
                            @foreach (var reason in reasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>Restricción de acceso desconocida.</span>
                    }
                }
                else
                {
                    <span>Debes iniciar sesión para acceder a esta sección.</span>
                }
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al Inicio</a>
            </div>
        </div>
    </div>
</div>